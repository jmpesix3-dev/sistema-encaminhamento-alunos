# Encaminhamento Escolar de Alunos - Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///data/encaminhamento.db
DATABASE_ECHO=false

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_USE_TLS=true
EMAIL_FROM=seu-email@gmail.com

# App Settings
APP_TITLE=Encaminhamento Escolar de Alunos
APP_ICON=📋
PAGE_LAYOUT=wide

# Geolocalizacao
# Sem a chave, o sistema usa OpenStreetMap + posicao por distrito.
# Para usar o Google Maps (mais preciso para enderecos brasileiros):
#   https://console.cloud.google.com/ -> APIs e servicos -> APIs habilitadas
#   -> Geocoding API  ->  Credenciais -> Chave da API
#
# ATENCAO: NUNCA escreva sua chave aqui. Este arquivo vai para o Git.
# Coloque a chave no arquivo .env (copie este para .env e preencha ali).
GOOGLE_MAPS_API_KEY=

# Ordem de tentativa dos provedores
GEO_PROVEDORES=google,nominatim,distrito